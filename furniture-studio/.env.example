# Supabase — см. README.md, раздел 2 "Как подключить Supabase"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Публичный домен сайта (используется в metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секрет для защиты внутренних вызовов ревалидации (задел на будущее, см. README)
REVALIDATE_SECRET=

# --- Резервные копии (lib/backup/) — см. lib/backup/README.md ---
# Секрет, которым Vercel Cron подписывает вызов еженедельного автобэкапа.
# Vercel сам присылает его в заголовке Authorization при вызове по расписанию —
# нужно просто сгенерировать случайную строку и вставить сюда и в Vercel env.
CRON_SECRET=
# Ключ Resend (https://resend.com) — на него отправляется письмо с бэкапом.
RESEND_API_KEY=
# Куда слать бэкап и от чьего имени (адрес должен быть подтверждён в Resend).
BACKUP_EMAIL_TO=
BACKUP_EMAIL_FROM=
